@PACKAGE_INIT@

set_and_check(ShitEngine_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(ShitEngine_LIB_DIR     "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

# 规范化为绝对路径（去掉 lib/.. 段）——CMake 的 if(EXISTS) 不解析 `..`，
# 含 ../bin 拼接会误判 DLL 不存在，导致 -d 探测/并存警告全部失效
get_filename_component(_BIN_DIR "${ShitEngine_LIB_DIR}/../bin" ABSOLUTE)
set(_LIB_DIR "${ShitEngine_LIB_DIR}")
set(_INC_DIR "${ShitEngine_INCLUDE_DIR}")

# ============================================================
# Debug/Release 文件名后缀：Debug 版本带 -d 后缀
# ============================================================
if(CMAKE_BUILD_TYPE STREQUAL "Debug" OR CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
    set(_SE_SUFFIX "-d")
elseif(CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_BUILD_TYPE STREQUAL "MinSizeRel")
    # 显式 Release：尊重用户选择，不做后缀回退（运行时一致性由用户保证）
    set(_SE_SUFFIX "")
else()
    # 未显式指定构建类型（多配置生成器 / 未传 CMAKE_BUILD_TYPE）：
    # 按 SDK bin/ 实际安装的 DLL 形态探测，并给「双版本并存」明确的警告——
    # 插件 DLL 的导入名必须与运行时引擎一致，并存且不判定时默认选 -d 匹配插件/编辑器生态。
    set(_SE_SUFFIX "")
    if(EXISTS "${_BIN_DIR}/ShitEngine-d.dll")
        if(NOT EXISTS "${_BIN_DIR}/ShitEngine.dll")
            set(_SE_SUFFIX "-d")
            message(STATUS "ShitEngine: SDK 仅含 Debug 运行库（ShitEngine-d.dll），统一使用 -d 后缀")
        else()
            set(_SE_SUFFIX "-d")
            message(WARNING
                "ShitEngine: SDK 同时含有 ShitEngine.dll 与 ShitEngine-d.dll，且未指定构建类型。\n"
                "  已默认选用 Debug（-d）以匹配插件/编辑器运行时；如需 Release 请显式设置 "
                "CMAKE_BUILD_TYPE=Release，并移除 SDK 中另一版本避免混淆。")
        endif()
    endif()
endif()

# ============================================================
# 创建 imported target（DLL 不存在则跳过，该依赖已静态链接）
# ============================================================
set(_FOUND_DEPS "")

# _create_dll(target 库名 是否带 Debug -d 后缀)
#   第三方依赖（SDL3 等）只有一份 DLL，Debug/Release 共用，不带 -d 后缀；
#   只有 ShitEngine 自身带 -d 后缀（ShitEngine-d.dll 的导入表引用的也是同名 SDL3.dll）。
macro(_create_dll _target _base_name _with_suffix)
    set(_sfx "")
    if(_with_suffix)
        set(_sfx "${_SE_SUFFIX}")
    endif()
    if(WIN32)
        set(_loc "${_BIN_DIR}/${_base_name}${_sfx}.dll")
        set(_implib "${_LIB_DIR}/${_base_name}${_sfx}.lib")
        if(MINGW)
            set(_implib "${_LIB_DIR}/lib${_base_name}${_sfx}.dll.a")
        endif()
    elseif(APPLE)
        set(_loc "${_LIB_DIR}/lib${_base_name}${_sfx}.dylib")
    else()
        set(_loc "${_LIB_DIR}/lib${_base_name}${_sfx}.so")
    endif()
    if(EXISTS "${_loc}")
        add_library(${_target} SHARED IMPORTED)
        set_target_properties(${_target} PROPERTIES IMPORTED_LOCATION "${_loc}")
        if(EXISTS "${_implib}")
            set_target_properties(${_target} PROPERTIES IMPORTED_IMPLIB "${_implib}")
            list(APPEND _FOUND_DEPS "${_target}")
        endif()
    else()
        message(STATUS "ShitEngine: ${_target} DLL not found (${_loc}), assume statically linked")
    endif()
endmacro()

_create_dll(SDL3::SDL3 "SDL3" OFF)
_create_dll(SDL3_mixer::SDL3_mixer "SDL3_mixer" OFF)
_create_dll(SDL3_image::SDL3_image "SDL3_image" OFF)
_create_dll(SDL3_ttf::SDL3_ttf "SDL3_ttf" OFF)

# header-only / 可能静态链接的依赖
# spdlog: 可能静态编入 ShitEngine.dll，不需要用户链接
if(NOT TARGET spdlog::spdlog)
    add_library(spdlog::spdlog INTERFACE IMPORTED)
endif()
if(NOT TARGET glm::glm)
    add_library(glm::glm INTERFACE IMPORTED)
endif()
if(NOT TARGET nlohmann_json::nlohmann_json)
    add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED)
endif()

# ============================================================
# ShitEngine 自身
# ============================================================
add_library(ShitEngine::ShitEngine SHARED IMPORTED)

if(WIN32)
    if(MINGW)
        set(_SE_DLL "${_BIN_DIR}/libShitEngine${_SE_SUFFIX}.dll")
        set(_SE_LIB "${_LIB_DIR}/libShitEngine${_SE_SUFFIX}.dll.a")
    elseif(MSVC)
        set(_SE_DLL "${_BIN_DIR}/ShitEngine${_SE_SUFFIX}.dll")
        set(_SE_LIB "${_LIB_DIR}/ShitEngine${_SE_SUFFIX}.lib")
    endif()
elseif(APPLE)
    set(_SE_DLL "${_LIB_DIR}/libShitEngine${_SE_SUFFIX}.dylib")
else()
    set(_SE_DLL "${_LIB_DIR}/libShitEngine${_SE_SUFFIX}.so")
endif()

# 只链接实际找到的依赖
# 只链接 DLL 和导入库都存在的依赖（_FOUND_DEPS）
set(_LINK_LIBS "spdlog::spdlog;glm::glm;nlohmann_json::nlohmann_json")
foreach(_dep IN LISTS _FOUND_DEPS)
    list(APPEND _LINK_LIBS "${_dep}")
endforeach()

set_target_properties(ShitEngine::ShitEngine PROPERTIES
    IMPORTED_LOCATION             "${_SE_DLL}"
    IMPORTED_IMPLIB               "${_SE_LIB}"
    INTERFACE_INCLUDE_DIRECTORIES "${_INC_DIR}"
    INTERFACE_COMPILE_OPTIONS     "$<$<CXX_COMPILER_ID:MSVC>:/utf-8>"
    INTERFACE_COMPILE_FEATURES    "cxx_std_20"
    INTERFACE_LINK_LIBRARIES      "${_LINK_LIBS}"
)

check_required_components(ShitEngine)
